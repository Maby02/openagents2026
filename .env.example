# =============================================================================
# REQUIRED — without these, sibyl cannot trade on Delphi
# =============================================================================

# Funded EVM wallet (Sepolia ETH bridged to Gensyn testnet + 1000 mock USDC).
# See README "Funding your wallet" for the bridge + faucet steps.
WALLET_PRIVATE_KEY=

# Read-side Delphi API key. Free, no email needed.
# Get one at: https://delphi-api-access-app.pages.dev/
DELPHI_API_ACCESS_KEY=

# Path to the AXL `node` binary (Go build of github.com/gensyn-ai/axl).
# If unset, sibyl will look at $SIBYL_HOME/node and `axl-node` on $PATH.
# SIBYL_AXL_BINARY=/absolute/path/to/node

# =============================================================================
# OPTIONAL
# =============================================================================

# Set this only if you want to run the bundled LLM strategy. Sibyl core does
# not need it; the strategy is skipped cleanly when unset.
# OPENAI_API_KEY=

# Where sibyl stores keys + AXL config. Defaults to ~/.sibyl
# SIBYL_HOME=

# Delphi network defaults — change only if you know why.
DELPHI_NETWORK=testnet
DELPHI_SIGNER_TYPE=private_key
GENSYN_RPC_URL=https://gensyn-testnet.g.alchemy.com/public
GENSYN_CHAIN_ID=685685

# AXL HTTP API port. Two nodes on one machine need different ports.
SIBYL_AXL_API_PORT=9002

# Local SSE port that streams events.jsonl in real time (used by the web app).
SIBYL_OBSERVE_PORT=9099
